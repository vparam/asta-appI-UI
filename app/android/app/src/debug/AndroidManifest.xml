<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. Allows cleartext traffic to 10.0.2.2 (Android emulator's
  loopback) so the app can reach the local mock REST server. This file is NOT
  merged into release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application
    tools:replace="android:networkSecurityConfig"
    android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
