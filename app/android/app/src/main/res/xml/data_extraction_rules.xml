<?xml version="1.0" encoding="utf-8"?>
<!--
  §3.2 / §16.7: PPLM Mobile holds opaque tokens, vitals, and predictions, but
  no patient PII. Even so, we deny ALL backup and ALL device transfer of app
  data — both contain MMKV stores with telemetry events and last-viewed
  timestamps that, if exfiltrated alongside a roster, narrow re-identification.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
  </device-transfer>
</data-extraction-rules>
