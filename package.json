{
  "name": "asta-pplm-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "PPLM Mobile Bedside — React Native + native modules + mock server",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "setup": "node scripts/setup-native.js",
    "ios": "yarn workspace asta-pplm-app ios",
    "android": "yarn workspace asta-pplm-app android",
    "start": "yarn workspace asta-pplm-app start",
    "server": "yarn workspace asta-pplm-server dev",
    "test": "yarn workspaces run test",
    "audit:pii": "node scripts/audit-pii.js",
    "lint": "yarn workspaces run lint"
  },
  "engines": {
    "node": ">=20"
  }
}
